# portfolio-frontend/Dockerfile.prod
FROM node:20-alpine AS build
WORKDIR /app

# Accept build arg
ARG VITE_API_URL

# Make it available as environment variable for Vite
ENV VITE_API_URL=$VITE_API_URL

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY --from=build /app/dist ./dist
RUN npm install -g serve
EXPOSE 3000
CMD ["serve", "-s", "dist", "-l", "3000"]