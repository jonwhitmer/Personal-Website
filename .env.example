# jonwhitmer.com — every environment variable the three services read.
#
# Copy the relevant block into a real .env file and fill in the values.
# Real .env files are gitignored and must never be committed.
#
#   portfolio-backend/.env    the Spring API
#   python-service/.env       the RAG service (not currently deployed)
#   portfolio-frontend/.env   build-time only, and PUBLIC — see the warning below


# ============================================================
#  portfolio-backend  (Spring Boot, :8080, live at api.jonwhitmer.com)
# ============================================================

# Where contact-form messages and resume requests are delivered.
# This is the inbox that receives everything a visitor sends. Get it wrong and messages
# vanish while the sender is told "Message sent successfully!".
MY_EMAIL=you@example.com

# --- Local development mail (dev profile) ---
# A Google App Password, NOT the account password. Generated at
# https://myaccount.google.com/apppasswords with 2FA enabled. 16 characters, no spaces.
#
# The dev profile sets spring.mail.test-connection=true, which means Spring verifies this
# login DURING STARTUP and aborts if it fails. An unset or stale value does not degrade
# gracefully — the whole backend refuses to boot.
GMAIL_APP_PASSWORD=

# --- Production mail (prod profile) ---
# Brevo (formerly Sendinblue) SMTP key. Starts with `xkeysib-`.
BREVO_KEY=

# The exact origin allowed to call this API, used by CorsConfig.
# Production: https://www.jonwhitmer.com
# Local:      http://localhost:5173   <- the port matters; a bare http://localhost fails CORS
FRONTEND_ORIGIN=http://localhost:5173

# Which application-<profile>.properties file is loaded. `dev` or `prod`.
SPRING_PROFILES_ACTIVE=dev


# ============================================================
#  portfolio-frontend  (React + Vite, :5173, live at www.jonwhitmer.com)
# ============================================================

# ⚠️ EVERY VITE_* VARIABLE IS BAKED INTO THE PUBLIC JAVASCRIPT BUNDLE AT BUILD TIME.
#    Anyone can read them by viewing source. Never put a credential here.
#
# Where the frontend sends contact-form and resume requests.
#   Local:      http://localhost:8080
#   Production: https://api.jonwhitmer.com
#
# If this is unset the bundle inlines the literal string `undefined`, and every request
# goes to `undefined/api/contact` — the form fails silently with no error a visitor sees.
VITE_API_URL=http://localhost:8080

# The address the Copy / Gmail / Outlook buttons point at.
#
# REQUIRED. The build throws if it is missing or has no @ in it, deliberately: an unset
# value ships a page where every contact route is `mailto:undefined`, and the buttons still
# look like they work. A loud build failure is better than a silent dead end.
#
# Keep this the SAME as MY_EMAIL above. They used to differ — the page handed out one
# address while the API delivered to another — so a visitor who used the Copy button and a
# visitor who used the form reached two different inboxes.
VITE_CONTACT_EMAIL=you@example.com


# ============================================================
#  python-service  (the "Jaymik" RAG service — built, not deployed)
# ============================================================

# Groq API key for the language model. Starts with `gsk_`.
GROQ_API_KEY=


# ============================================================
#  QA suite (optional)
# ============================================================

# Point the browser tests at something other than a local dev server.
# SITE_URL=https://www.jonwhitmer.com
